msgid "You pressed 'Ctrl+C', exiting..."
msgstr "Vous avez appuyé sur 'Ctrl+C', sortie..."

msgid "{} [{}] has {} reports with {} of swap variation average and {} of swap average. They took {}"
msgstr "{} [{}] a {} rapports avec {} de variation moyenne de swap et {} de moyenne de swap. Cela a pris {}"

msgid "There isn't log to list"
msgstr "Il n'y a pas de journal à lister"

msgid "This app logs swap information in /var/lib/swapping_ebuilds.txt compiling Gentoo packages. This allow you to change in package.env the number of processors used, to decrease swapping and improve ebuild time compilation"
msgstr "Cette application enregistre les informations de swap dans /var/lib/swapping_ebuilds.txt lors de la compilation des paquets Gentoo. Cela vous permet de modifier le nombre de processeurs utilisés dans package.env, afin de réduire le swapping et d'améliorer le temps de compilation des ebuilds."

msgid "Developed by Mariano Muñoz 2017-{}"
msgstr "Développé par Mariano Muñoz 2017-{}"

msgid "Optional Parameters"
msgstr "Paramètres optionnels"

msgid "Seconds between measurements. Default is 10"
msgstr "Secondes entre les mesures. La valeur par défaut est 10"

msgid "Minutes of swapping required to highlight ebuilds with --analyze. Default is 15"
msgstr "Minutes de swapping requises pour surligner les ebuilds avec --analyze. La valeur par défaut est 15"

msgid "Number of consecutive logs with swapping required to highlight with --list. Default is 3"
msgstr "Nombre de journaux consécutifs avec swapping requis pour surligner avec --list. La valeur par défaut est 3"

msgid "Shows in --list and --analyze only highlighted records"
msgstr "Affiche dans --list et --analyze uniquement les enregistrements surlignés"

msgid "Analyze log"
msgstr "Analyser le journal"

msgid "Generate log"
msgstr "Générer le journal"

msgid "Clean log"
msgstr "Nettoyer le journal"

msgid "List log"
msgstr "Lister le journal"

msgid "--hl_analyze must be positive"
msgstr "--hl_analyze doit être positif"

msgid "--hl_list must be greater than 1"
msgstr "--hl_list doit être supérieur à 1"

msgid "Attempting to clean log file..."
msgstr "Tentative de nettoyage du fichier journal..."

msgid "Log cleaned"
msgstr "Journal nettoyé"

msgid "Log already cleaned"
msgstr "Journal déjà nettoyé"

msgid "Listing log entries:"
msgstr "Liste des entrées du journal :"

msgid "No swapping detected"
msgstr "Aucun swapping détecté"
